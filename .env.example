# Generate a strong random value for your local .env; never reuse this text.
FLASK_SECRET_KEY=replace-with-a-unique-random-secret
APP_ENV=development

# Configure up to three private users. Generate a separate Werkzeug password
# hash for each user with scripts\generate_password_hash.py. Leave a slot blank
# to disable it; never put plaintext passwords here.
# Example:
# AERIS_USER_1_USERNAME=operator
# AERIS_USER_1_PASSWORD_HASH=replace-with-a-generated-password-hash
# AERIS_USER_2_USERNAME=analyst
# AERIS_USER_2_PASSWORD_HASH=replace-with-a-generated-password-hash
AERIS_USER_1_USERNAME=
AERIS_USER_1_PASSWORD_HASH=
AERIS_USER_2_USERNAME=
AERIS_USER_2_PASSWORD_HASH=
AERIS_USER_3_USERNAME=
AERIS_USER_3_PASSWORD_HASH=

# Optional. Use the Neon-provided PostgreSQL URL to enable analysis history.
NEON_DATABASE_URL=

# Optional. Local analysis and charts work without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Point to the directory containing locally trained trusted artifacts.
# Never expose writable model artifacts to untrusted users.
MODEL_ARTIFACT_DIRECTORY=models
